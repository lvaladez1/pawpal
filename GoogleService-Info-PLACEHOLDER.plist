<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 
    ⚠️ IMPORTANT - This is a PLACEHOLDER ⚠️
    
    You MUST create your own Firebase project and replace this file.
    
    Steps:
    1. Go to https://console.firebase.google.com
    2. Create a new Firebase project
    3. Add an iOS app to your project
    4. Download YOUR OWN GoogleService-Info.plist
    5. Replace this placeholder file with your downloaded file
    6. Rename it to GoogleService-Info.plist (remove -PLACEHOLDER)
    
    See FIREBASE_SETUP.md for complete instructions.
    -->
    <key>API_KEY</key>
    <string>YOUR-API-KEY-FROM-FIREBASE</string>
    <key>GCM_SENDER_ID</key>
    <string>YOUR-SENDER-ID</string>
    <key>PROJECT_ID</key>
    <string>your-firebase-project-id</string>
    <key>STORAGE_BUCKET</key>
    <string>your-project.appspot.com</string>
    <key>CLIENT_ID</key>
    <string>YOUR-CLIENT-ID.apps.googleusercontent.com</string>
    <key>REVERSED_CLIENT_ID</key>
    <string>com.googleusercontent.apps.YOUR-CLIENT-ID</string>
    <key>GOOGLE_APP_ID</key>
    <string>1:YOUR-APP-ID:ios:YOUR-IOS-ID</string>
    <key>DATABASE_URL</key>
    <string>https://your-project.firebaseio.com</string>
</dict>
</plist>
